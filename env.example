# ==============================================================================
# ENVIRONMENT VARIABLES TEMPLATE
# Copy this file to '.env' before running the application: cp env.example .env
# ==============================================================================

# Active Profile:
SPRING_PROFILES_ACTIVE=dev

# Server Configuration
SERVER_PORT=7777
SERVER_SSL_ENABLED=true

# SSL/TLS Configuration
SSL_KEY_STORE_TYPE=PKCS12
SSL_KEY_STORE=file:./keystore.p12
SSL_KEY_STORE_PASSWORD=your_store_password_here
SSL_KEY_PASSWORD=your_password_here
SSL_KEY_ALIAS=tomcat

# Database Credentials (PostgreSQL)
DB_URL=jdbc:postgresql://localhost:5433/gym
DB_DRIVER=org.postgresql.Driver
DB_USERNAME=gym
DB_PASSWORD=gym

# SonarQube Analysis
# Generated in SonarQube UI: Account > My Account > Security
# Required for: mvn clean verify sonar:sonar -Dsonar.token=SONAR_TOKEN
# SONAR_TOKEN=your_sonar_token_here