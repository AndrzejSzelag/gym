# =============================================================================
# LOMBOK GLOBAL CONFIGURATION
# =============================================================================

# --- [ HIERARCHY CONTROL ] ---
# Prevents searching for config files in parent directories for build consistency
config.stopBubbling = true

# --- [ CODE QUALITY & ANALYSIS ] ---
# Marks generated methods with @lombok.Generated
# Required for JaCoCo and SonarQube to exclude boilerplate from coverage reports
lombok.addLombokGeneratedAnnotation = true